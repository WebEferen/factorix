# openssl rand -base64 32
FACTORIX_SECRET_KEY=

# What your browser and webhooks use to reach the web container.
# Baked into the web image for link previews, so rebuild web after changing it.
FACTORIX_PUBLIC_URL=http://localhost:4101
COOKIE_SECURE=false

# Lets you click through the whole flow with a stand-in for the model. Keep it off in production.
FACTORIX_ALLOW_SCRIPTED_RUNTIME=false

# Everything below is a default that Settings, General can override without a restart.
# Leave a value empty to use the built-in default shown here.

# How many agent runs at once.
FACTORIX_RUN_CONCURRENCY=3
# How often to reconcile with the tracker and GitLab, in seconds.
FACTORIX_SYNC_INTERVAL_SECONDS=300
# How far back to import closed issues, in days.
FACTORIX_CLOSED_ISSUE_DAYS=90
# How long to wait for more merge request comments before starting a run, in minutes.
FACTORIX_NOTE_DEBOUNCE_MINUTES=3
# The longest the reviewer waits for CI before starting anyway, in minutes.
FACTORIX_CI_WAIT_MINUTES=30
# Delete package caches from a workspace when a run ends.
FACTORIX_CLEAR_RUN_CACHE=true
# When to delete a workspace: hours after an issue finishes (0 is at the next cleanup),
# days after it fails, and days with no activity while it is open.
FACTORIX_FINISHED_WORKSPACE_HOURS=0
FACTORIX_FAILED_WORKSPACE_DAYS=7
FACTORIX_OPEN_WORKSPACE_DAYS=30
# How long to keep a failed run's container for inspection, in hours.
FACTORIX_FAILED_CONTAINER_HOURS=1
# How long a login lasts, in days.
FACTORIX_SESSION_DAYS=30

# Fallback model keys. A connection under Settings takes priority.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
