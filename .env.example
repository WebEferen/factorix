# openssl rand -base64 32
FACTORIX_SECRET_KEY=

# What your browser and webhooks use to reach the web container.
# Baked into the web image for link previews, so rebuild web after changing it.
FACTORIX_PUBLIC_URL=http://localhost:4101
COOKIE_SECURE=false

# Lets you click through the whole flow with a stand-in for the model. Keep it off in production.
FACTORIX_ALLOW_SCRIPTED_RUNTIME=false

# Fallback model keys. A connection under Settings takes priority.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
