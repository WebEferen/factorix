#!/bin/sh
# Lives in the image so a repo's own hook setup (husky and friends) cannot drop attribution.
[ -n "${FX_AGENT:-}" ] && git interpret-trailers --in-place --if-exists doNothing --trailer "Factorix-Agent: $FX_AGENT" "$1"
[ -n "${FX_RUN:-}" ] && git interpret-trailers --in-place --if-exists doNothing --trailer "Factorix-Run: $FX_RUN" "$1"
exit 0
